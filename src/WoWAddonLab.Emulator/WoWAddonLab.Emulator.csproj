<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <RootNamespace>WoWAddonLab.Emulator</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Lua.NET" Version="6.0.1" />
    <PackageReference Include="System.Formats.Cbor" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Lua\Runtime\WowCompat.lua"
                      LogicalName="WoWAddonLab.Emulator.Lua.WowCompat.lua" />
  </ItemGroup>

</Project>
